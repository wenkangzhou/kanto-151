# Server-only Supabase configuration. Never use NEXT_PUBLIC_ prefixes.
# Copy to .env.local, or add these names in Vercel Environment Variables.
# Project root URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# Settings > API Keys > Publishable and secret API keys
# sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... (server only; never commit the actual value)
SUPABASE_SECRET_KEY=

# Generate both with npm run setup:secrets; copy from .env.local into Vercel.
# Independent random secrets, each at least 40 characters. Server only.
APP_SESSION_SECRET=
# Parent-only first setup / PIN recovery password; enter it on /setup.
APP_SETUP_TOKEN=
