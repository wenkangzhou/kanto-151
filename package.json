  "private": true,
  "scripts": {
    "dev": "next dev --port 42751",
    "build": "next build",
    "start": "next start --port 42751",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:sync": "python3 scripts/sync-pokemon.py",
    "prebuild": "node --import tsx scripts/check-env.ts --allow-empty",
    "postbuild": "node --import tsx scripts/check-client-bundle.ts",
    "verify": "npm run lint && npm run sql:check && npm test",
    "setup:secrets": "node --import tsx scripts/setup-secrets.ts",
    "sql:rules": "node --import tsx scripts/generate-sql-rules.ts",
    "sql:check": "node --import tsx scripts/generate-sql-rules.ts --check",
    "check:env": "node --import tsx scripts/check-env.ts",
    "check:supabase": "node --import tsx scripts/check-env.ts --connect"
